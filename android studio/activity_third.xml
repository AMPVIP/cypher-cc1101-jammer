<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A1A2E"
    android:padding="16dp">

    <!-- Заголовок -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔄 Обработка текста"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FF6B6B"
        android:gravity="center"
        android:padding="8dp" />

    <!-- Поле ввода -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Введите текст:"
        android:textSize="14sp"
        android:textColor="#C9D1D9"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:background="#2D2D44"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:padding="10dp"
        android:hint="Напишите что-нибудь..."
        android:textColorHint="#666666"
        android:inputType="textMultiLine"
        android:gravity="top|start"
        android:layout_marginBottom="8dp" />

    <!-- Выбор действия -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Выберите действие:"
        android:textSize="14sp"
        android:textColor="#C9D1D9"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinnerAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2D2D44"
        android:padding="8dp"
        android:layout_marginBottom="8dp" />

    <!-- Кнопки: Выполнить + Сохранить -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnAction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="⚡ Выполнить"
            android:textSize="14sp"
            android:backgroundTint="#FF6B6B"
            android:textColor="#FFFFFF"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="💾 Сохранить"
            android:textSize="14sp"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:padding="12dp" />

    </LinearLayout>

    <!-- Кнопки: Копировать + Очистить -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnCopy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="📋 Копировать"
            android:textSize="14sp"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="🧹 Очистить"
            android:textSize="14sp"
            android:backgroundTint="#607D8B"
            android:textColor="#FFFFFF"
            android:padding="12dp" />

    </LinearLayout>

    <!-- Результат -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Результат:"
        android:textSize="14sp"
        android:textColor="#C9D1D9"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvOutput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp"
        android:background="#2D2D44"
        android:textColor="#4CAF50"
        android:textSize="16sp"
        android:padding="10dp"
        android:text="Результат будет здесь"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- История -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📜 История сохранений:"
            android:textSize="14sp"
            android:textColor="#C9D1D9" />

        <Button
            android:id="@+id/btnClearHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🗑️ Очистить"
            android:textSize="12sp"
            android:backgroundTint="#F44336"
            android:textColor="#FFFFFF"
            android:padding="8dp" />

    </LinearLayout>

    <!-- Поле для отображения истории -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#2D2D44"
        android:padding="8dp"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/tvHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📭 История пуста\n\nНажмите для добавления"
            android:textSize="12sp"
            android:textColor="#C9D1D9"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

    </ScrollView>

    <!-- Подсказка для свайпа -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="← Swipe left to go back →"
        android:textSize="11sp"
        android:textColor="#8B949E"
        android:gravity="center"
        android:padding="8dp" />

</LinearLayout>